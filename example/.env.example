# AgentBeats Example Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for using OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional, if using Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google API Key (optional, if using Gemini models)
# GOOGLE_API_KEY=your-google-api-key-here

# White Agent Configuration
WHITE_AGENT_PORT=8001
WHITE_LAUNCHER_PORT=7001

# Green Agent Configuration
GREEN_AGENT_PORT=8002
GREEN_LAUNCHER_PORT=7002

# Agent URLs (fill these in after exposing with Cloudflare Tunnel)
WHITE_AGENT_URL=https://your-cloudflare-url.trycloudflare.com
WHITE_LAUNCHER_URL=https://your-cloudflare-url.trycloudflare.com
GREEN_AGENT_URL=https://your-cloudflare-url.trycloudflare.com
GREEN_LAUNCHER_URL=https://your-cloudflare-url.trycloudflare.com

# Model Configuration
MODEL_TYPE=openai
MODEL_NAME=gpt-4o-mini

# AgentBeats Backend (default)
AGENTBEATS_BACKEND=https://agentbeats.org
